// [표준 CRUD 버전]
// - Status 대신 HTTP 메서드로 구분: C=POST, U=PATCH, D=DELETE
// - 여러 행은 화면에서 $batch의 changeset 하나로 묶어 보냄 → 한 LUW (하나라도 실패하면 전체 롤백)
// - with additional save: 00410은 managed가 저장, 같은 트랜잭션에서 save_modified가 00420 저장
managed with additional save implementation in class zbp_mrmd_r_matsupdemmastersave unique;
strict ( 2 );

define behavior for ZMRMD_R_MatSupDemMasterSave alias MatSup
persistent table ztmrmd00410          // TODO: 실제 테이블명
lock master
authorization master ( global )
{
  create;
  update;
  delete;

  // 키: 생성 때만 입력, 수정 불가 → U는 SupplyRatio, Remark만 바뀜
  field ( mandatory : create, readonly : update ) CompanyCode, Material, Supplier, GoodsSupplier;

  // 생성 시 필수 입력 + 중복 + 유효성(회사코드/자재/공급업체/물품공급업체) 체크
  validation validateOnCreate on save { create; }

  mapping for ztmrmd00410              // TODO: 오른쪽 컬럼명을 실제 컬럼명으로
  {
    CompanyCode   = bukrs;
    Material      = matnr;
    Supplier      = lifnr;
    GoodsSupplier = goods_lifnr;
    SupplyRatio   = supply_ratio;
    Remark        = remark;
  }
}
