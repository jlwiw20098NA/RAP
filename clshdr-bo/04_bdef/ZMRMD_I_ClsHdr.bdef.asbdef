managed implementation in class zbp_mrmd_i_clshdr unique;
strict ( 2 );

define behavior for ZMRMD_I_ClsHdr alias Header
persistent table zmrmd_t_clshdr
lock master
authorization master ( global )
{
  create;
  update;
  delete;

  field ( mandatory : create, readonly : update )
    CompanyCode, ClassLevel1, ClassLevel2, ClassLevel3, ManufacturingProcess;
  field ( mandatory ) ItemGroupCode;
  field ( readonly ) CreateDate, CreateTime, ChangeDate, ChangeTime,
                     CreatedTimestamp, ChangedTimestamp, CreatedBy, ChangedBy;

  // 헤더 + 아이템을 한 번에 생성/수정
  static action SaveAll deep parameter ZMRMD_A_SaveClsHdr;

  // 생성/변경 일시 (ERDAT/ERZET, AEDAT/AEZET)
  // 변경 트리거는 업무 필드만: 'update' 전체로 걸면 자기 변경으로 재실행될 수 있음
  determination setCreateStamp on save { create; }
  determination setChangeStamp on save { field ItemGroupCode, KiloUnit; }

  validation validateCompanyCode on save { create; field CompanyCode; }

  mapping for zmrmd_t_clshdr
  {
    CompanyCode          = company_code;
    ClassLevel1          = class_level1;
    ClassLevel2          = class_level2;
    ClassLevel3          = class_level3;
    ManufacturingProcess = mfg_process;
    ItemGroupCode        = item_group;
    KiloUnit             = kilo_unit;
    CreateDate           = erdat;
    CreateTime           = erzet;
    CreatedBy            = ernam;
    ChangeDate           = aedat;
    ChangeTime           = aezet;
    ChangedBy            = aenam;
    // CreatedTimestamp, ChangedTimestamp: 계산 필드라 매핑하지 않음
  }
}
