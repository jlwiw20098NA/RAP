// with additional save: 00410은 managed 프레임워크가 저장하고,
//                       같은 트랜잭션에서 save_modified가 00420을 직접 저장
managed with additional save implementation in class zbp_mrmd_r_matsupdemmastersave unique;
strict ( 2 );

define behavior for ZMRMD_R_MatSupDemMasterSave alias MatSup
persistent table ztmrmd00410          // TODO: 실제 테이블명
lock master
authorization master ( global )
{
  // CRUD는 internal: API로는 SaveAll(Status C/U/D)로만 저장 가능
  internal create;
  internal update;
  internal delete;

  field ( readonly : update ) CompanyCode, Material, Supplier, GoodsSupplier;

  static action SaveAll deep parameter ZMRMD_A_MatSupSaveReq;

  mapping for ztmrmd00410              // TODO: 오른쪽 컬럼명을 실제 컬럼명으로
  {
    CompanyCode   = bukrs;
    Material      = matnr;
    Supplier      = lifnr;
    GoodsSupplier = goods_lifnr;
    SupplyRatio   = supply_ratio;
    Remark        = remark;
  }
}
